{
  "name": "flixa-backend",
  "version": "1.0.0",
  "description": "OpenAI API style backend with /v1/agent router",
  "main": "server.ts",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch server.ts",
    "build": "bun build server.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openai",
    "api",
    "agent",
    "router",
    "hono",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openrouter/sdk": "^0.8.0",
    "hono": "^4.11.8",
    "openai": "^6.18.0",
    "pg": "^8.18.0"
  },
  "engines": {
    "node": "22.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3"
  }
}