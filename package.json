{
  "name": "flixa-backend",
  "version": "1.0.0",
  "description": "OpenAI API style backend with /v1/agent router",
  "main": "server.ts",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch server.ts",
    "dev:prod-env": "bun --env-file=.env.production --watch server.ts",
    "build": "bun build server.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "tools:revoke-anonymous-api-keys": "bun run tools/revoke-anonymous-api-keys.ts",
    "tools:ban-flixa-user": "bun run tools/ban-flixa-user.ts",
    "tools:unban-flixa-user": "bun run tools/unban-flixa-user.ts"
  },
  "keywords": [
    "openai",
    "api",
    "agent",
    "router",
    "hono",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@openrouter/sdk": "^0.12.79",
    "hono": "^4.12.23",
    "openai": "^6.42.0",
    "pg": "^8.21.0"
  },
  "engines": {
    "node": "22.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3"
  }
}
