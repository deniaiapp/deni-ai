{
  "name": "flixa-backend",
  "version": "1.0.0",
  "description": "OpenAI API style backend with /v1/agent router",
  "main": "server.ts",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch server.ts",
    "dev:prod-env": "bun --env-file=.env.production --watch server.ts",
    "build": "bun build server.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "performance:benchmark": "bun run tools/performance-benchmark.ts",
    "tools:revoke-anonymous-api-keys": "bun run tools/revoke-anonymous-api-keys.ts",
    "tools:ban-flixa-user": "bun run tools/ban-flixa-user.ts",
    "tools:unban-flixa-user": "bun run tools/unban-flixa-user.ts"
  },
  "keywords": [
    "openai",
    "api",
    "agent",
    "router",
    "hono",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@openrouter/sdk": "^1.2.7",
    "hono": "^4.13.0",
    "openai": "^7.4.0",
    "pg": "^8.22.0"
  },
  "engines": {
    "node": "22.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@openrouter/sdk"
  ]
}
