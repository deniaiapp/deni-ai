{
  "name": "deni-run",
  "version": "0.1.0",
  "private": true,
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "@embedded-postgres/windows-x64",
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "test:core": "tsx scripts/verify-review-fixes.ts && tsx scripts/verify-cron.ts && tsx scripts/verify-job-ui.ts && tsx scripts/verify-chat-sessions.ts && tsx scripts/verify-migrations.ts && tsx scripts/verify-jobs-mcp.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:logs": "node scripts/local-db.mjs logs",
    "db:status": "node scripts/local-db.mjs status",
    "prepare": "husky"
  },
