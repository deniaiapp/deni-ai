    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "ai": "^7.0.137",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "e2b": "^2.55.0",
    "emoji-picker-react": "^4.22.3",
    "emoji-regex": "^11.0.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.54.0",
    "motion": "^14.1.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "playwright": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "steel-sdk": "^0.18.0",
    "streamdown": "^2.7.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
