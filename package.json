{
  "name": "deni-run",
  "version": "0.1.0",
  "private": true,
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "workerd"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite build",
    "start": "vite start",
    "worker": "tsx worker/index.ts",
    "test:core": "tsx scripts/verify-review-fixes.ts && tsx scripts/verify-cron.ts && tsx scripts/verify-job-ui.ts && tsx scripts/verify-chat-sessions.ts && tsx scripts/verify-context-window.ts && tsx scripts/verify-history.ts && tsx scripts/verify-migrations.ts && tsx scripts/verify-jobs-mcp.ts && tsx scripts/verify-d1-semantics.ts && tsx scripts/verify-auth-d1.ts && tsx scripts/verify-two-factor-methods.ts && tsx scripts/verify-plugin-disconnect.ts && tsx scripts/verify-discord.ts && tsx scripts/verify-discord-team.ts && tsx scripts/verify-discord-skills.ts && tsx scripts/verify-discord-tasks.ts && tsx scripts/verify-discord-files.ts && tsx scripts/verify-discord-plugins.ts",
    "typecheck": "vinext typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply deni-run --remote --config d1-proxy/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply deni-run --local --config d1-proxy/wrangler.jsonc",
    "d1:deploy": "wrangler deploy --config d1-proxy/wrangler.jsonc",
    "d1:copy-from-postgres": "tsx scripts/migrate-pg-to-d1.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.140",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@base-ui/react": "^1.9.0",
