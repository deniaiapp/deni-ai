{
  "name": "deni-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --output src/db/schema/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:dev": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "drizzle-kit push",
    "tools:codename": "tsx --env-file-if-exists=.env.local ./tools/codename-generator.ts",
    "tools:update-types": "tsx ./tools/update-types.ts",
    "tools:stripe-max-mode": "tsx --env-file-if-exists=.env.local ./tools/stripe-max-mode-setup.ts",
    "tools:stripe-portal": "tsx --env-file-if-exists=.env.local ./tools/stripe-portal-setup.ts",
    "tools:commit": "tsx --env-file-if-exists=.env.local ./tools/commit.ts",
    "tools:grant-card-flash-offer": "tsx --env-file-if-exists=.env.local ./tools/grant-card-flash-offer.ts",
    "tools:purge-anonymous": "tsx --env-file=.env.production ./tools/purge-anonymous.ts",
    "tools:migrate-private-attachments": "tsx --env-file=.env.production ./tools/migrate-private-attachments.ts",
    "disposable:refresh": "pnpm --filter @deni-ai/disposable-email-domains refresh",
    "test": "vitest run",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.89",
    "@ai-sdk/react": "^4.0.136",
    "@ai-sdk/xai": "^5.0.19",
    "@base-ui/react": "^1.8.0",
    "@better-auth-ui/core": "^1.7.27",
    "@better-auth-ui/react": "^1.7.27",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@deni-ai/disposable-email-domains": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@neondatabase/serverless": "^1.2.0",
    "@next/third-parties": "^16.4.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@sentry/nextjs": "^11.5.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.133",
    "better-auth": "^1.7.7",
    "bowser": "^2.14.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-email": "^6.11.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "stripe": "^23.0.0",
    "sucrase": "^3.35.1",
    "sugar-high": "^2.6.0",
    "superjson": "^2.2.6",
    "undici": "^8.11.2",
    "uploadthing": "^7.7.4",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.7",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react-doctor": "^0.9.17",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.8.1"
}
