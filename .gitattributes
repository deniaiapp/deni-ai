# Keep LF everywhere so Windows checkouts (core.autocrlf=true) match the LF
# formatter output and the repository instead of showing phantom changes.
* text=auto eol=lf

# next-intl embeds these as JSON.parse("..."); CRLF breaks that wrapper on Windows.
messages/*.json text eol=lf

# pnpm applies these against LF package files; CRLF checkouts break the patch.
patches/*.patch text eol=lf
