# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_32_byte_base64_secret
BETTER_AUTH_URL=http://localhost:3000

# Optional: skip OAuth and 2FA on localhost in `pnpm dev` only.
# Uses a dedicated local user in the database; never enable on a shared/deployed server.
LOCAL_AUTH_BYPASS=false

# Google OAuth. Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth. Redirect: {BETTER_AUTH_URL}/api/auth/callback/github
# Use scope user:email (OAuth App) or Email addresses: Read-only (GitHub App).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack connector (Slack MCP server). Slack has no dynamic client registration, so it needs an
# internal or Marketplace Slack app with the MCP server turned on under Agents, the user token
# scopes listed for Slack in lib/mcp-catalog.ts (they are all requested), and the redirect URL
# {BETTER_AUTH_URL}/api/mcp/oauth/callback. Notion and Linear need
# nothing here. Without these, the Slack connector says it is not set up.
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=

# Development only: an https tunnel to the dev server for MCP OAuth callbacks (Slack wants https
# redirects). Callbacks arriving there are handed back to BETTER_AUTH_URL, so keep browsing on
# localhost. With a quick tunnel: cloudflared tunnel --url http://localhost:3000
# MCP_OAUTH_BASE_URL=https://example.trycloudflare.com

# Two-factor codes by email (Resend). Optional; without both, email is not offered at setup.
# EMAIL_FROM must use a domain verified in Resend, e.g. Deni Run <auth@run.deniai.app>.
RESEND_API_KEY=
EMAIL_FROM=

# Database: Cloudflare D1, reached through the d1-proxy Worker (see docs/d1-migration.md).
# Deploy the Worker with `pnpm d1:deploy`, then set its URL and the shared secret:
#   wrangler secret put PROXY_TOKEN --config d1-proxy/wrangler.jsonc
D1_PROXY_URL=https://d1.example.com
D1_PROXY_TOKEN=
# Leave D1_PROXY_URL empty in development to use a local SQLite file instead
# (created and migrated automatically; override the path with LOCAL_DB_PATH).
# LOCAL_DB_PATH=.deni/local.sqlite

# 32 random bytes encoded as base64. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# OpenRouter. If omitted, users can provide their own key in the setup screen.
OPENROUTER_API_KEY=

# Exa web search. Optional; the webSearch tool is hidden from teammates when unset.
EXA_API_KEY=

# Steel Cloud. One persistent browser profile is created per signed-in user.
STEEL_API_KEY=
STEEL_BASE_URL=https://api.steel.dev
STEEL_SESSION_IDLE_MS=600000
STEEL_SESSION_TIMEOUT_MS=900000
STEEL_SESSION_INACTIVITY_TIMEOUT_MS=600000

# Public site URL.
# Also a Docker build arg — rebuild the image after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on Terms, Privacy, and Account. Optional.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional JSON webhook for server errors.
ERROR_WEBHOOK_URL=

# Deni AI: sign-in, plan, and usage. Register the OAuth client in Deni AI with
# `pnpm run tools:register-oauth-client` (redirect: {BETTER_AUTH_URL}/api/auth/callback/deni-ai).
DENI_AI_URL=https://deniai.app
DENI_AI_CLIENT_ID=
DENI_AI_CLIENT_SECRET=
# Shared with Deni AI's DENI_RUN_SERVICE_SECRET (32+ random characters). Usage is checked against
# and reported to Deni AI. Unset: development runs unmetered and production refuses work.
DENI_RUN_SERVICE_SECRET=
# Provider cost of browser (Steel) and computer (E2B) time, in USD per hour.
# DENI_RUN_BROWSER_USD_PER_HOUR=0.10
# DENI_RUN_COMPUTER_USD_PER_HOUR=0.15

# S3-compatible workspace and screenshot storage (Cloudflare R2 or AWS S3).
# For R2 use https://<accountid>.r2.cloudflarestorage.com — do not append the bucket name.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# E2B. One paused/resumable sandbox is kept per signed-in user.
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT_MS=600000
E2B_SANDBOX_IDLE_MS=600000

# Discord bot for chatting with teammates in direct messages. Optional; the Discord card in
# Plugins is hidden while the token is unset. Set it on every instance (the card needs it) -
# only the instance with DENI_SCHEDULER=true connects to Discord. See the README.
DISCORD_BOT_TOKEN=
# Install link people open to add the bot (Developer Portal > Installation > Install Link, with
# User Install enabled). Shown on the Discord card; without it users cannot find the bot.
DISCORD_INVITE_URL=

# Run this only on one dedicated instance. docker-compose defaults to true.
DENI_SCHEDULER=false
