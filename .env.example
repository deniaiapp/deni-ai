# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_32_byte_base64_secret
BETTER_AUTH_URL=http://localhost:3000

# Optional: skip OAuth and 2FA on localhost in `next dev` only.
# Uses a dedicated local user in Postgres; never enable on a shared/deployed server.
LOCAL_AUTH_BYPASS=false

# Google OAuth. Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth. Redirect: {BETTER_AUTH_URL}/api/auth/callback/github
# Use scope user:email (OAuth App) or Email addresses: Read-only (GitHub App).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Postgres
DATABASE_URL=postgres://user:password@host:5432/deni
DATABASE_POOL_MAX=10

# Optional port for native PostgreSQL started by `bun db:start` (no Docker).
LOCAL_POSTGRES_PORT=5432
# Local database connection: postgres://deni:deni@127.0.0.1:5432/deni

# PostgreSQL service included in Docker Compose / Dokploy.
# Generate a URL-safe password: openssl rand -hex 32
POSTGRES_DB=deni
POSTGRES_USER=deni
POSTGRES_PASSWORD=
# When ready to use this database, set DATABASE_URL to:
# postgres://deni:<POSTGRES_PASSWORD>@postgres:5432/deni
# The postgres hostname is reachable from the Compose network, not this PC.

# 32 random bytes encoded as base64. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# OpenRouter. If omitted, users can provide their own key in the setup screen.
OPENROUTER_API_KEY=

# Exa web search. Optional; the webSearch tool is hidden from teammates when unset.
EXA_API_KEY=

# Steel Cloud. One persistent browser profile is created per signed-in user.
STEEL_API_KEY=
STEEL_BASE_URL=https://api.steel.dev
STEEL_SESSION_IDLE_MS=600000
STEEL_SESSION_TIMEOUT_MS=900000
STEEL_SESSION_INACTIVITY_TIMEOUT_MS=600000

# Public site URL used for Stripe redirects.
# Also a Docker build arg — rebuild the image after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on Terms, Privacy, and Account. Optional.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional JSON webhook for server errors.
ERROR_WEBHOOK_URL=

# Stripe billing (optional). Without these, Free plan limits still apply.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# S3-compatible workspace and screenshot storage (Cloudflare R2 or AWS S3).
# For R2 use https://<accountid>.r2.cloudflarestorage.com — do not append the bucket name.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# E2B. One paused/resumable sandbox is kept per signed-in user.
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT_MS=600000
E2B_SANDBOX_IDLE_MS=600000

# Run this only on one dedicated instance. docker-compose defaults to true.
DENI_SCHEDULER=false
