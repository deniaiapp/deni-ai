# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# App URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Authentication (OAuth is optional; omit a provider pair to hide that button)
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe Billing (omit Stripe keys to disable billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Customer Portal configuration without in-portal plan changes (`pnpm run tools:stripe-portal`).
# If unset, the Dashboard default portal configuration must have subscription updates disabled.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional. A production server runs its periodic jobs in-process without it: usage recovery
# every minute, storage cleanup hourly, and model health probes
# every 5 minutes (results public at GET /api/status/models). Set it (a random secret of at
# least 32 characters) only to trigger them manually or from an external scheduler, which
# serverless hosts (Vercel) need: GET /api/cron/max-mode-meter-events, /api/cron/storage-cleanup and
# /api/cron/model-health with Authorization: Bearer <CRON_SECRET>. Unset, those routes answer 503.
CRON_SECRET=

# Non-production copies of the app (e.g. a canary deployment). Set to 1 to skip the
# in-process jobs above and the model health probes (which spend provider tokens), and to
# send `X-Robots-Tag: noindex, nofollow` with a robots.txt that disallows everything.
DISABLE_BACKGROUND_JOBS=
NOINDEX=

# Deni Run integration (optional). Deni AI is the OAuth provider for Deni Run and keeps its
# usage budget. DENI_RUN_SERVICE_SECRET (32+ random characters, same value in Deni Run)
# authenticates Deni Run's calls to /api/integrations/deni-run/usage; unset, that API answers 503.
# DENI_RUN_OAUTH_CLIENT_ID is the client printed by `pnpm run tools:register-oauth-client`.
DENI_RUN_SERVICE_SECRET=
DENI_RUN_OAUTH_CLIENT_ID=
# Deni Run origin linked from the usage view (default https://run.deniai.app).
NEXT_PUBLIC_DENI_RUN_URL=

# AI Providers (OpenRouter serves all platform chat models)
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Deni AI API (OpenAI-compatible). Key required to expose OpenAI models.
DENI_API_KEY=
DENI_API_BASE_URL=https://api.deniai.app/v1

# Optional chat quota weights (before the model multiplier). Empty = default.
# Input 1, cache read 0.1, cache write 1.25, output 5.
# parseFloat semantics; invalid, negative or non-finite values use defaults.
FLIXA_USAGE_WEIGHT_INPUT=
FLIXA_USAGE_WEIGHT_CACHE_READ=
FLIXA_USAGE_WEIGHT_CACHE_WRITE=
FLIXA_USAGE_WEIGHT_OUTPUT=

# Search (omit to disable web search)
EXA_API_KEY=your-exa-api-key

# CAPTCHA (omit both to disable Turnstile)
TURNSTILE_SECRET_KEY=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Error monitoring, logs, and traces — Sentry (optional; omit to disable). Production builds only.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (optional; all three needed). Use an org auth token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Email — Cloudflare Email Sending (optional; both required to enable)
# Domain must be onboarded in Cloudflare dashboard (Email Service → Email Sending).
# API token needs Email Sending: Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Upstash Redis — distributed rate limiting (optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 — private attachment storage (optional, falls back to base64 URLs)
# All four are required. Create an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Client IP behind proxies (rate limits, ad dedup; see SETUP.md)
# Behind Cloudflare (origin reachable only via Cloudflare): CLIENT_IP_HEADER=cf-connecting-ip
# Behind N proxies that append to X-Forwarded-For: TRUSTED_PROXY_HOPS=N
# Leave both empty only if the edge overwrites X-Forwarded-For (otherwise it is spoofable).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=

# Optional Stripe flash offer coupon
# STRIPE_FLASH_OFFER_COUPON_ID=

# Operator administration (optional; comma-separated server-side admin emails).
# Grants reset credits and receives dispute alerts. AFFILIATE_ADMIN_EMAILS is still read as a fallback.
# ADMIN_EMAILS=you@example.com

# Blog administration (optional; falls back to ADMIN_EMAILS)
# BLOG_ADMIN_EMAILS=you@example.com

# Operator email domains (optional; comma-separated). Accounts on these domains may
# sign up even when the domain is not on the sign-up allowlist, and once their email
# is verified they administer the blog and reset credits.
# ADMIN_EMAIL_DOMAINS=example.com

# Optional toggles
NEXT_PUBLIC_BILLING_DISABLED=

# Deni AI Ads requires STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and OPENROUTER_API_KEY.
