{
  "name": "@deniai/db",
  "version": "0.0.1",
  "private": true,
  "description": "Drizzle schema and migrations for the Deni AI database (public and flixa schemas)",
  "type": "module",
  "exports": {
    ".": "./src/schema/index.ts",
    "./flixa": "./src/flixa/schema.ts",
    "./paths": "./src/paths.ts",
    "./type-registry": "./src/type-registry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../apps/web/.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:canary": "node --env-file=../../apps/web/.env.canary ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:dev": "node --env-file=../../apps/web/.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=../../apps/web/.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:generate:flixa": "drizzle-kit generate --config drizzle.flixa.config.ts",
    "db:migrate:flixa": "node --env-file-if-exists=../../services/agent-api/.env ./node_modules/drizzle-kit/bin.cjs migrate --config drizzle.flixa.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
