{
  "name": "@deniai/emails",
  "version": "0.0.1",
  "private": true,
  "description": "Deni AI transactional email templates (react-email) and their HTML/plain-text render helper",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./render": "./src/render.ts",
    "./org-invitation-email-subject": "./src/org-invitation-email-subject.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "react-email": "^6.11.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
