{
  "name": "@deniai/billing",
  "version": "0.0.1",
  "private": true,
  "description": "Billing rules shared by Deni AI chat and Flixa: pure usage-pool, plan, usage-tier, token-weighting and education-domain rules, and the server-side usage engine",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@deniai/db": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "drizzle-orm": "^0.45.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
