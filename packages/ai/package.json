{
  "name": "@deniai/ai",
  "version": "0.0.1",
  "private": true,
  "description": "Deni AI chat model catalog and plan access rules, the OpenRouter provider factory, reasoning message helpers and pure chat tool definitions",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./models": "./src/models.ts",
    "./openrouter": "./src/openrouter.ts",
    "./reasoning": "./src/reasoning.ts",
    "./tools/*": "./src/tools/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@deniai/billing": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.155",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
