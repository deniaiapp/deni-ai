{
  "name": "deni-run",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "worker": "tsx src/server/worker.ts",
    "test:core": "tsx tests/review-fixes.ts && tsx tests/cron.ts && tsx tests/job-ui.ts && tsx tests/teammate-copy.ts && tsx tests/chat-sessions.ts && tsx tests/message-actions.ts && tsx tests/message-bubbles.ts && tsx tests/context-window.ts && tsx tests/history.ts && tsx tests/compaction.ts && tsx tests/migrations.ts && tsx tests/jobs-mcp.ts && tsx tests/computer-errors.ts && tsx tests/mcp-explain.ts && tsx tests/mcp-oauth.ts && tsx tests/d1-semantics.ts && tsx tests/auth-d1.ts && tsx tests/two-factor-methods.ts && tsx tests/plugin-disconnect.ts && tsx tests/github-plugin.ts && tsx tests/discord.ts && tsx tests/discord-team.ts && tsx tests/discord-skills.ts && tsx tests/discord-tasks.ts && tsx tests/discord-files.ts && tsx tests/discord-plugins.ts",
    "typecheck": "tsc --noEmit",
    "messages:extract": "tsx scripts/extract-messages.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply deni-run --remote --config services/d1-proxy/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply deni-run --local --config services/d1-proxy/wrangler.jsonc",
    "d1:deploy": "wrangler deploy --config services/d1-proxy/wrangler.jsonc",
