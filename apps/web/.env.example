# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# App URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Authentication (OAuth is optional; omit a provider pair to hide that button)
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe Billing (omit Stripe keys to disable billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Customer Portal configuration without in-portal plan changes (`pnpm run tools:stripe-portal`).
# If unset, the Dashboard default portal configuration must have subscription updates disabled.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional. A production server runs its periodic jobs in-process without it: usage recovery
# every minute, storage cleanup hourly, and model health probes
# every 5 minutes (results public at GET /api/status/models). Set it (a random secret of at
# least 32 characters) only to trigger them manually or from an external scheduler, which
# serverless hosts (Vercel) need: GET /api/cron/usage-and-meter, /api/cron/storage-cleanup and
# /api/cron/model-health with Authorization: Bearer <CRON_SECRET>. Unset, those routes answer 503.
CRON_SECRET=

# Non-production copies of the app (e.g. a canary deployment). Set to 1 to skip the
# in-process jobs above and the model health probes (which spend provider tokens), and to
# send `X-Robots-Tag: noindex, nofollow` with a robots.txt that disallows everything.
DISABLE_BACKGROUND_JOBS=
NOINDEX=
# A deployment that shares its database with another one (the v8 beta next to v7,
# docs/v8-beta-rollout.md). CRON_ENABLED=false (default true) turns /api/cron/* into
# no-ops and keeps the in-process usage recovery, storage and guest cleanup jobs off;
# model health probes still run. STRIPE_WEBHOOK_ENABLED=false (default true) answers
# /api/stripe/webhook with 503 so only the other deployment processes Stripe events.
CRON_ENABLED=
STRIPE_WEBHOOK_ENABLED=

# Deni Run integration (optional). Deni AI is the OAuth provider for Deni Run and keeps its
# usage budget. DENI_RUN_SERVICE_SECRET (32+ random characters, same value in Deni Run)
# authenticates Deni Run's calls to /api/integrations/deni-run/usage; unset, that API answers 503.
# DENI_RUN_OAUTH_CLIENT_ID is the client printed by `pnpm run tools:register-oauth-client`.
DENI_RUN_SERVICE_SECRET=
DENI_RUN_OAUTH_CLIENT_ID=
# Deni Run origin linked from the usage view (default https://run.deniai.app).
NEXT_PUBLIC_DENI_RUN_URL=

# Run mode (/run, `@deniai/run`). Everything is optional: without a provider the matching
# feature shows a disabled state. The language model is OPENROUTER_API_KEY below; web search
# is EXA_API_KEY. RUN_ENCRYPTION_KEY (32 bytes, base64: openssl rand -base64 32) encrypts MCP
# credentials; unset, a key is derived from BETTER_AUTH_SECRET.
# RUN_ENABLED=false (default true) switches Run mode off: no sidebar switch, /run/* redirects
# to /chat, /api/run/* answers 404 and the in-process scheduler never starts. Data is kept.
RUN_ENABLED=
RUN_ENCRYPTION_KEY=
# Computer: E2B sandbox (terminal) and Steel cloud browser (live view and takeover).
E2B_API_KEY=
STEEL_API_KEY=
STEEL_BASE_URL=
# Workspace files and screenshots (S3 or Cloudflare R2); unset, a local .deni/ directory.
RUN_S3_ENDPOINT=
RUN_S3_REGION=
RUN_S3_ACCESS_KEY_ID=
RUN_S3_SECRET_ACCESS_KEY=
RUN_S3_BUCKET=
# Provider cost charged to the shared usage pool, USD per hour (defaults 0.10 and 0.15).
RUN_BROWSER_USD_PER_HOUR=
RUN_COMPUTER_USD_PER_HOUR=
# true: run Run's job scheduler inside this server (started at boot) instead of
# @deniai/run-worker. One web instance only. Also for local development.
RUN_SCHEDULER_IN_PROCESS=
RUN_SCHEDULER_CONCURRENCY=
# With RUN_SCHEDULER_IN_PROCESS: true also runs the Discord bot here (needs DISCORD_BOT_TOKEN).
RUN_DISCORD_ENABLED=
# How long a shutdown waits for running Run jobs, in ms (default 8000; minidock allows 10 s).
RUN_SHUTDOWN_TIMEOUT_MS=
# Slack MCP connector client (Slack has no dynamic client registration).
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
# Discord bot token and install link: the bot runs here with RUN_DISCORD_ENABLED, or in
# @deniai/run-worker; the link card needs DISCORD_INVITE_URL either way.
DISCORD_BOT_TOKEN=
DISCORD_INVITE_URL=

# AI Providers (OpenRouter serves all platform chat models)
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Deni AI API (OpenAI-compatible). Key required to expose OpenAI models.
DENI_API_KEY=
DENI_API_BASE_URL=https://api.deniai.app/v1

# Optional chat quota weights (before the model multiplier). Empty = default.
# Input 1, cache read 0.1, cache write 1.25, output 5.
# parseFloat semantics; invalid, negative or non-finite values use defaults.
FLIXA_USAGE_WEIGHT_INPUT=
FLIXA_USAGE_WEIGHT_CACHE_READ=
FLIXA_USAGE_WEIGHT_CACHE_WRITE=
FLIXA_USAGE_WEIGHT_OUTPUT=

# Search (omit to disable web search)
EXA_API_KEY=your-exa-api-key

# CAPTCHA (omit both to disable Turnstile)
TURNSTILE_SECRET_KEY=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Error monitoring, logs, and traces — Sentry (optional; omit to disable). Production builds only.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (optional; all three needed). Use an org auth token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Email — Cloudflare Email Sending (optional; both required to enable)
# Domain must be onboarded in Cloudflare dashboard (Email Service → Email Sending).
# API token needs Email Sending: Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Upstash Redis — distributed rate limiting (optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 — private attachment storage (optional, falls back to base64 URLs)
# All four are required. Create an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Client IP behind proxies (rate limits, ad dedup; see SETUP.md)
# Behind Cloudflare (origin reachable only via Cloudflare): CLIENT_IP_HEADER=cf-connecting-ip
# Behind N proxies that append to X-Forwarded-For: TRUSTED_PROXY_HOPS=N
# Leave both empty only if the edge overwrites X-Forwarded-For (otherwise it is spoofable).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=

# Optional Stripe flash offer coupon
# STRIPE_FLASH_OFFER_COUPON_ID=

# Operator administration (optional; comma-separated server-side admin emails).
# Grants reset credits and receives dispute alerts.
# ADMIN_EMAILS=you@example.com

# Operator email domains (optional; comma-separated). Accounts on these domains may
# sign up even when the domain is not on the sign-up allowlist, and once their email
# is verified they can grant reset credits.
# ADMIN_EMAIL_DOMAINS=example.com

# Two-factor requirement for password accounts without Google or GitHub linked (optional).
# ISO date or date-time; before it they see a reminder with this deadline, from it
# signed-in app pages send them to /two-factor/setup. Unset: reminder only.
# PASSWORD_2FA_REQUIRED_FROM=2027-01-15

# Private beta (optional; default false). true: only accounts in the beta_access table
# (Settings > Beta testers, managed by the admins above) and verified admins may use the
# app and its signed-in APIs (others get 403 beta_access_required and the /private-beta
# screen); guest sign-in is refused. See docs/v8-beta-rollout.md.
BETA_ACCESS_REQUIRED=
# With the gate on, true also lets in every account on a paid plan (Go, Plus, Pro, or a team
# plan; not Go through education), no invitation needed. Default false.
BETA_ACCESS_PAID_PLANS=

# true while the rollout Worker splits deniai.app between v7 and v8 (docs/v8-rollout.md):
# the account menu offers "Switch to the previous version" (/__rollout/v7). Default false.
ROLLOUT_SWITCH_ENABLED=
# Deni AI v7, linked from the account menu and /private-beta (build time; default https://deniai.app).
NEXT_PUBLIC_V7_URL=

# Oldest Deni AI Desktop version the native client API (/api/client/v1) accepts, e.g. 1.0.0
# (optional). Older clients get 426 client_update_required. Unset: any version.
DESKTOP_MIN_CLIENT_VERSION=

# Passkey relying party ID (optional). Unset: the host of the auth URL. A subdomain such as
# beta.deniai.app sets deniai.app so passkeys registered on deniai.app work there.
PASSKEY_RP_ID=

# Optional toggles
NEXT_PUBLIC_BILLING_DISABLED=

# Deni AI Ads requires STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and OPENROUTER_API_KEY.
