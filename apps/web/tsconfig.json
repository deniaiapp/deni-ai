{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "lucide-react": ["./src/lib/lucide-react.ts"],
      "date-fns": ["./src/lib/date-fns.ts"],
      "date-fns/locale": ["./src/lib/date-fns-locale.ts"]
    }
  },
  "types": ["node", "react", "react-dom"],
  "include": [
    "css-types.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite/**/*.ts",
    "drizzle.config.ts",
    "doctor.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "tools",
    "dist",
    "build",
    "coverage",
    ".output",
    ".tanstack",
    ".nitro"
  ]
}
