{
  "name": "@deniai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --output ../../packages/db/src/schema/auth-schema.ts --yes",
    "db:generate": "pnpm --filter @deniai/db db:generate",
    "db:migrate": "pnpm --filter @deniai/db db:migrate",
    "db:migrate:canary": "pnpm --filter @deniai/db db:migrate:canary",
    "db:migrate:dev": "pnpm --filter @deniai/db db:migrate:dev",
    "db:push": "pnpm --filter @deniai/db db:push",
    "tools:codename": "tsx --env-file-if-exists=.env.local ./tools/codename-generator.ts",
    "tools:update-types": "tsx ./tools/update-types.ts",
    "tools:stripe-portal": "tsx --env-file-if-exists=.env.local ./tools/stripe-portal-setup.ts",
    "tools:commit": "tsx --env-file-if-exists=.env.local ./tools/commit.ts",
    "tools:register-oauth-client": "tsx --env-file-if-exists=.env.local ./tools/register-oauth-client.ts",
    "disposable:refresh": "pnpm --filter @deni-ai/disposable-email-domains refresh",
    "test": "vitest run",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/react": "^4.0.159",
    "@ai-sdk/xai": "^5.0.32",
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "^1.7.32",
    "@better-auth-ui/react": "^1.7.32",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@deni-ai/disposable-email-domains": "workspace:*",
    "@deniai/billing": "workspace:*",
    "@deniai/db": "workspace:*",
    "@deniai/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@marsidev/react-turnstile": "^1.6.3",
    "@neondatabase/serverless": "^1.2.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@sentry/tanstackstart-react": "^11.9.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@upstash/redis": "^1.40.0",
    "ai": "^7.0.155",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "bowser": "^2.15.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-email": "^6.11.4",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "stripe": "^23.0.1",
    "sucrase": "^3.35.1",
    "sugar-high": "^2.6.4",
    "superjson": "^2.2.6",
    "undici": "^8.12.3",
    "use-intl": "^4.14.9",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "^1.7.14",
    "drizzle-kit": "^0.31.11",
    "next-intl-swc-plugin-extractor": "^4.14.9",
    "nitro": "3.0.260903-beta",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react-doctor": "^0.9.18",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
