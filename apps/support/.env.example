# All variables are optional. Without them the help center still works and the
# matching support feature is turned off.

# AI support chat (Claude Haiku 5.5)
ANTHROPIC_API_KEY=

# Contact and feedback email via Cloudflare Email Sending
# (API token needs Email Sending: Edit on the account)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Defaults: contact@deniai.app / Deni AI Support <noreply@deniai.app>
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=

# Cloudflare Turnstile for the chat and forms (set both to enable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
